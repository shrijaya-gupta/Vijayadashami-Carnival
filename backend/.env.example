# ==============================================================================
# SRMU B5 Fun Games Event Registration Backend — Environment Configuration
# Copy this file to .env and adjust variables for your local/production environment
# ==============================================================================

# Server listening port
PORT=5000

# Node environment mode: development | production | test
NODE_ENV=development

# MongoDB connection string (Local or MongoDB Atlas)
# Local example: mongodb://127.0.0.1:27017/srmu_fun_games
# Atlas example: mongodb+srv://<username>:<password>@cluster.mongodb.net/srmu_fun_games?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/srmu_fun_games

# Allowed Client Origins for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Admin Dashboard Initial Credentials (Used on first boot to create initial admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<change-to-strong-password>

# Session Secret (Optional: Used for cryptographic salting)
SESSION_SECRET=srmu_b5_fun_games_secure_session_secret_2026
