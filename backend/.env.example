# ==============================================================================
# SRMU B5 Fun Games Event Registration Backend — Environment Configuration
# ==============================================================================

# Supabase Database Configuration
# Obtain these from your Supabase Project Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Allowed Origins for CORS
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://localhost:5173

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SrmuAdmin2026!Secure

# Session Security
SESSION_SECRET=srmu_b5_fun_games_secure_session_secret_2026
